# Copy to .env (git-ignored). Never commit real values.

PORT=3000
NODE_ENV=development

# Database: either DATABASE_URL, or the DB_* values below.
# In production connect as the restricted civicconnect_app role, not as postgres,
# otherwise the audit-log immutability grants have no effect.
# DATABASE_URL=postgres://civicconnect_app:CHANGE_ME@localhost:5432/civicconnect_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicconnect_db
DB_USER=postgres
DB_PASSWORD=postgres

# Required when NODE_ENV=production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared code municipal HR gives new staff. Leave EMPTY to close staff sign-up.
STAFF_REGISTRATION_CODE=

{
  "name": "civicconnect",
  "version": "1.0.0",
  "description": "CivicConnect Municipal Service Management API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.js",
    "test:blackbox": "node --test tests/blackbox/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "perf": "node tests/performance/staffQueueLoad.js",
    "test:all": "npm test && npm run test:blackbox && npm run test:integration && npm run test:e2e",
    "test:fsm": "node runFsmTest.js",
    "test:extended": "node runExtendedTests.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "globals": "^16.0.0",
    "supertest": "^7.3.0"
  }
}
